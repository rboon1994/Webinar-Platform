{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @webinar/shared build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @webinar/shared build",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretest": "pnpm --filter @webinar/shared build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "pretypecheck": "pnpm --filter @webinar/shared build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@webinar/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14"
  }
}
